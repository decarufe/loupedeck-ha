{
  "name": "loupedeck-ha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p . && pnpm run editor:build",
    "editor:dev": "pnpm --dir editor run dev",
    "editor:build": "pnpm --dir editor run build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run && pnpm --dir editor run test",
    "spike": "tsx scripts/spike-throughput.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@mdi/js": "^7.4.47",
    "@napi-rs/canvas": "^1.1.1",
    "fastify": "^5.12.8",
    "home-assistant-js-websocket": "^9.9.0",
    "loupedeck": "^7.2.1",
    "pino": "^10.4.0",
    "undici": "^8.12.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@12.8.1"
}
